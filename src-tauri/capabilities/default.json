{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права главного окна приложения",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-background-color",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/DEADover/FESB-Toolkit"
        }
      ]
    }
  ]
}
